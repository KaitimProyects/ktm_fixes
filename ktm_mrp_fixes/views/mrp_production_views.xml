<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        FIX: BOM with more than 40 components creates incomplete manufacturing orders.

        Upstream commit 3d43d9d9 (PERF: respect limit during onchange fetch) made the
        backend honour whatever limit the frontend sends. The default limit is 40, so
        BOMs with more lines have move_raw_ids silently truncated after the onchange.
        Setting limit="500" raises the threshold above any realistic BOM size.

        Remove this record once Odoo ships an official fix for the default limit.
    -->
    <record id="ktm_mrp_production_form_view" model="ir.ui.view">
        <field name="name">ktm.mrp.production.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']/list" position="attributes">
                <attribute name="limit">500</attribute>
            </xpath>
        </field>
    </record>
</odoo>
